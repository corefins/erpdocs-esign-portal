# Template for the hosted app's secrets.
#
# Do NOT fill this file in and commit it. Either:
#   - locally: copy to .streamlit/secrets.toml (gitignored), or
#   - hosted:  paste the filled-in content into the app's Settings -> Secrets box.
#
# The app reads [secrets] and [config] as drop-in replacements for the
# gitignored secrets.json / config.json it uses in development.

[secrets]
hub_workbook_id = "PASTE_HUB_SHEET_ID"
form_token_secret = "PASTE_A_LONG_RANDOM_STRING"

# SMTP — used for the client-facing form/invite emails this app sends itself.
smtp_server = "smtp.mailer91.com"
smtp_port = 587
smtp_use_tls = true
smtp_username = "PASTE_SMTP_USERNAME"
smtp_password = "PASTE_SMTP_PASSWORD"
smtp_from_email = "noreply@mail.erpdocs.com"
smtp_from_name = "ERPDocs"

# MUST be the deployed app's own https URL, with no trailing slash.
# Client links are built from this, so a localhost value here produces dead links.
form_base_url = "https://YOUR-APP.streamlit.app"

# ERPDocs API. A production key sends real envelopes to real signers.
erpdocs_base_url = "https://www.erpdocs.com"
erpdocs_api_key = "PASTE_ERPDOCS_API_KEY"

[config]
# Leave empty when hosted — credentials come from [gcp_service_account] below.
google_service_account_path = ""

# Google service account key, inlined. A hosted container has no key file.
# Copy these straight out of the downloaded JSON. Keep private_key as one
# line with literal \n escapes, exactly as it appears in the JSON.
[gcp_service_account]
type = "service_account"
project_id = "PASTE_PROJECT_ID"
private_key_id = "PASTE_PRIVATE_KEY_ID"
private_key = "-----BEGIN PRIVATE KEY-----\nPASTE\n-----END PRIVATE KEY-----\n"
client_email = "PASTE@PROJECT.iam.gserviceaccount.com"
client_id = "PASTE_CLIENT_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "PASTE_CERT_URL"
universe_domain = "googleapis.com"
